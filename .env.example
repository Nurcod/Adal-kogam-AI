# Скопируйте в .env и заполните. Файл .env НЕ коммитится (он в .gitignore).

# --- LLM (любой OpenAI-совместимый провайдер) ---
# Claude API (ключ: console.anthropic.com → API keys)
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Отключить скрытые рассуждения Gemini (иначе возможны пустые ответы)
LLM_REASONING_EFFORT=
# Семантический поиск (необязательно; пусто = только BM25)
EMBEDDINGS_MODEL=

# Альтернатива — OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Голос (Whisper). Groq — бесплатно: https://console.groq.com/keys ---
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3

# --- Telegram (ключ у @BotFather) ---
TELEGRAM_BOT_TOKEN=
# ID админов через запятую (узнать свой ID: @userinfobot) — для команды /stats
ADMIN_IDS=

# Пароль к /api/stats?token=... в веб-версии
ADMIN_TOKEN=change-me

# Порог релевантности поиска (0..1) и число фрагментов
MIN_SCORE=0.12
TOP_K=8
